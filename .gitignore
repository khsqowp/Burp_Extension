# This repo (Burp_Extension) tracks only the Burp extension and the two
# projects it directly talks to. Everything else under E:\temp\tools
# (generic downloaded tools, wordlist mirrors, unrelated scanner scripts)
# stays out.
/*
!/burp_extension/
!/proxy_scanner/
!/security_toolkit/
!/.gitignore

# --- Python build/runtime noise (proxy_scanner, security_toolkit) ---
__pycache__/
*.pyc
.venv/

# --- burp_extension (Maven build output) ---
/burp_extension/target/

# --- proxy_scanner (PyInstaller build output) ---
/proxy_scanner/build/
/proxy_scanner/dist/

# --- security_toolkit: runtime data, not source ---
# scanner-data holds real scan results/logs/db (incl. actual scan targets).
/security_toolkit/scanner-data/
# offline/bundle is regenerated by Export-OfflineBundle.ps1 (docker image tar
# alone is ~90MB); offline/runtime-data is the offline stack's own scan output.
/security_toolkit/offline/bundle/
/security_toolkit/offline/runtime-data/
# third-party tool mirrors used by the scanner (not this project's own code).
/security_toolkit/third_party_audit/nikto/
/security_toolkit/third_party_audit/nmap/
/security_toolkit/third_party_audit/nuclei-templates/
